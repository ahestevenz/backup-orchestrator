#
# Phase 0 spike settings. Edit these for your household, then load them in
# every shell you use for the spikes:   . ./spike.env

SERVER=server.home.lan        # the backup server (a Mac)
OPERATOR=ariel                 # your account on the server (server.receive_user)
BACKUP_VOL=/Volumes/Backup     # the external APFS (Case-sensitive) backup drive

TESTMAC=athena.home.lan        # one source Mac
ADMIN=ariel                    # admin account on the source Mac and the Linux host
TESTUSER=bntest                # throwaway non-admin user created for the spikes

LINUXHOST=columbia.home.lan    # a Debian 12 host

LABEL=ar.bleiben.bnspike       # launchd label prefix for spike jobs
SPIKE=/Users/Shared/bnspike    # scratch folder on each Mac (world-writable, sticky)
